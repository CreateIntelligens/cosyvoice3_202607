# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Visual Studio Code files
.vscode
.vs

# PyCharm files
.idea

# Eclipse Project settings
*.*project
.settings

# Sublime Text settings
*.sublime-workspace
*.sublime-project

# Editor temporaries
*.swn
*.swo
*.swp
*.swm
*~

# IPython notebook checkpoints
.ipynb_checkpoints

# macOS dir files
.DS_Store

exp
data
raw_wav
tensorboard
**/*build*

# The two rules above are broad on purpose (any `data` dir, anything named
# *build*), but they also catch source that the test bench needs at runtime:
# the Traditional→Simplified tables server.py loads on start-up, and the script
# that regenerates them. They are 184 KB of JSON plus one file of Python, so
# they belong in the repo — without them a fresh checkout starts with the
# conversion silently disabled.
!tools/build_token_safe_map.py
!tools/data/
!tools/data/*.json

# Clangd files
.cache
compile_commands.json

# train/inference files
*.wav
*.m4a
*.aac
*.pt
pretrained_models/*
*_pb2_grpc.py
*_pb2.py
*.tar

# Local dataset quality-control reports may contain transcripts and NAS paths.
reports/

# Local container workspace: copied smoke data, models, parquet and checkpoints.
/workspace/

# Test-bench models: symlinks and multi-GB checkpoints, never committed.
models/

# Batch listening-test output: generated WAVs plus the manifest/score sheets that
# name them. Regenerated by docker/testbench/batch_eval.py, never worth committing.
docker/testbench/eval/
